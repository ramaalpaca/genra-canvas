# Genra Canvas — copy to web/.env.local for local development (gitignored).

# Genra backend origin. The canvas talks to its OpenAI-compatible facade at <origin>/openai/v1/*
# and reads the points balance from <origin>/api/v1/generate/points-balance.
VITE_GENRA_API_URL=http://localhost:8000

# Supabase project used by genra.ai (same values as video_mvp frontend / editor_web).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Main site origin: unauthenticated users are sent to <origin>/login; the points badge links to <origin>/pricing.
VITE_FRONTEND_URL=https://genra.ai

# Optional switches (defaults shown)
# VITE_GENRA_CHANNEL_LOCKED=true   # false: expose upstream provider / local proxy / WebDAV UI
# VITE_GENRA_LOCAL_AGENT=false     # true: show the local Canvas Agent UI again
